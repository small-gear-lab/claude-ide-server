msgstr ""
"`filePath`、`preview`、`startText`、`endText`、`selectToEndOfLine`、`makeFrontmost`"
" → `{ filePath, languageId, lineCount, isDirty, isUntitled, selection? }`"

#: ../../DESIGN.md:266
#, python-brace-format
msgid "→ `{ tabs: [{ uri, isActive, label, languageId, isDirty, ... }] }`"
msgstr "→ `{ tabs: [{ uri, isActive, label, languageId, isDirty, ... }] }`"

#: ../../DESIGN.md:267 ../../DESIGN.md:268
#, python-brace-format
